if SHIELD_MY_KEYBOARD_RIGHT

config ZMK_KEYBOARD_NAME
    default "My Keyboard"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif
if SHIELD_MY_KEYBOARD_LEFT

config ZMK_SPLIT_ROLE_CENTRAL
    default n

endif
if SHIELD_MY_KEYBOARD_LEFT || SHIELD_MY_KEYBOARD_RIGHT

config ZMK_SPLIT
    default y

endif