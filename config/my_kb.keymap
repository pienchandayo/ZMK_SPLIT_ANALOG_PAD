#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>


/ {
	keymap {
		compatible = "zmk,keymap";
		


		default_layer {
			bindings = <
			&kp ESC          	&kp N1                  &kp N2                  &kp N3                  &kp N4          &kp N5          &none               &none               &kp N6      &kp N7          &kp N8          &kp N9              &kp N0          &kp BSPC 
			&kp GRAVE           &kp Q                   &kp W                   &kp E                   &kp R           &kp T           &none               &none               &kp Y       &kp U           &kp I           &kp O               &kp P           &kp BACKSLASH
			&kp LEFT_WIN        &kp A                   &kp S                   &kp D                   &kp F           &kp G           &kp LEFT_BRACKET    &kp RIGHT_BRACKET   &kp H       &kp J       	&kp K           &kp L               &kp SEMICOLON   &kp SINGLE_QUOTE
			&kp LEFT_SHIFT      &kp Z                   &kp X                   &kp C                   &kp V           &kp B           &kp MINUS           &kp PLUS            &kp N       &kp M           &kp COMMA       &kp DOT             &kp SLASH       &kp DELETE
			&kp LEFT_CONTROL    &kp LEFT_ALT            &none                   &kp TAB            		&kp SPACE       &kp A           &kp LEFT_SHIFT      &mkp LCLK           &none		&kp ENTER       &kp BACKSPACE   &none               &kp F7          &kp F10
			>;
		};
		// layer_1 {
		// 	// 7列(左) + 7列(右) = 14列 × 5行 = 全70キー分
		// 	bindings = <
		// 	&none               &bt BT_SEL 0            &bt BT_SEL 1            &bt BT_SEL 2            &kp F4          &none                                                   &none       &kp F7          &none           &none              &kp F10         	&none               &none
		// 	&none               &none                   &none                   &kp UP                  &none           &none                                                   &none       &msc SCRL_LEFT  &msc SCRL_UP    &msc SCRL_RIGHT    &none           	&none
		// 	&none               &none                   &kp LEFT                &kp DOWN                &kp RIGHT       &none           &none               &none               &none       &mkp LCLK       &mkp MCLK       &mkp RCLK          &none           	&none
		// 	&none               &none                   &none                   &none                   &none           &none           &none               &none               &none       &none           &msc SCRL_DOWN  &none              &none           	&bt BT_CLR
		// 	&none               &none                                           &none                   &none           &trans          &none               &none                           &none           &none                              &none           	&none
		// 	>;
		// };
	};
	
};