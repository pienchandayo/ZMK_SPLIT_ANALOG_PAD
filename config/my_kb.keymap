#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>


/ {
	keymap {
		compatible = "zmk,keymap";
		default_layer {
			bindings = <
			&kp ESC          	&kp N1                  &kp N2                  &kp N3                  &kp N4          &kp N5          &none               &none               &kp N6      &kp N7          &kp N8          &kp N9              &kp N0          &kp BSPC 			&kp A
			&kp GRAVE           &kp Q                   &kp W                   &kp E                   &kp R           &kp T           &none               &none               &kp Y       &kp U           &kp I           &kp O               &kp P           &kp BACKSLASH
			&kp LEFT_WIN        &kp A                   &kp S                   &kp D                   &kp F           &kp G           &kp LEFT_BRACKET    &kp RIGHT_BRACKET   &kp H       &kp J       	&kp K           &kp L               &kp SEMICOLON   &kp SINGLE_QUOTE
			&kp LEFT_SHIFT      &kp Z                   &kp X                   &kp C                   &kp V           &kp B           &kp MINUS           &kp PLUS            &kp N       &kp M           &kp COMMA       &kp DOT             &kp SLASH       &kp DELETE
			&kp LEFT_CONTROL    &kp LEFT_ALT            &none                   &kp TAB            		&kp SPACE       &kp A           &kp LEFT_SHIFT      &mkp LCLK           &none		&kp ENTER       &kp BACKSPACE   &none               &kp F7          &kp F10
			>;
		};
	};
	
};