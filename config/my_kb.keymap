#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>

#define DEFAULT 0
#define FN   1

/ {
	keymap {
		compatible = "zmk,keymap";
		default_layer {
			bindings = <
			&kp ESC          	&kp N1                  &kp N2                  &kp N3                  &kp N4          &kp N5          &none               &none               &kp N6      &kp N7          &kp N8          &kp N9              &kp N0          &kp BSPC 			&mkp MCLK
			&kp GRAVE           &kp Q                   &kp W                   &kp E                   &kp R           &kp T           &none               &none               &kp Y       &kp U           &kp I           &kp O               &kp P           &kp BACKSLASH		&none
			&kp TAB		        &kp A                   &kp S                   &kp D                   &kp F           &kp G           &kp LEFT_BRACKET    &kp RIGHT_BRACKET   &kp H       &kp J       	&kp K           &kp L               &kp SEMICOLON   &kp SINGLE_QUOTE	&none
			&kp LEFT_SHIFT      &kp Z                   &kp X                   &kp C                   &kp V           &kp B           &kp MINUS           &kp EQUAL           &kp N       &kp M           &kp COMMA       &kp DOT             &kp SLASH       &kp DELETE			&none
			&kp LEFT_CONTROL    &kp LEFT_WIN            &none                   &kp LEFT_ALT       		&kp SPACE       &mo 1           &mkp LCLK      		&kp RIGHT_SHIFT     &none		&kp ENTER       &kp RIGHT_WIN   &none               &kp F7          &kp F10			&none
			>;
		};
		FN_layer {
			bindings = <
			&bt BT_CLR          &bt BT_SEL 1            &bt BT_SEL 2            &bt BT_SEL 3            &none           &none           &none               &none               &none       &none           &none           &none               &none           &none           &mkp MCLK
            &none               &none                   &none                   &kp UP                  &none           &none           &none               &none               &none       &mkp MB4        &none    		&mkp MB5            &none           &none			&none
            &none               &none                   &kp LEFT                &kp DOWN                &kp RIGHT       &none           &none               &none               &msc SCRL_UP &mkp LCLK  	&mkp MCLK  		&msc RCLK      		&none           &none			&none
            &none               &none                   &none                   &none                   &none           &none           &none               &none               &msc SCRL_DN &none          &none           &none               &none           &none			&none
            &none               &none                   &none                   &none                   &none           &trans          &mkp RCLK           &none           	&none       &none           &none           &none               &none           &none			&none
			>;
		};
	};
	
};